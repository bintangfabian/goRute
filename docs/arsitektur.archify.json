  "cards": [
    {
      "dot": "amber",
      "title": "Jalur rencana rute",
      "items": [
        "RAPTOR: putaran ke-k mencari tiba paling awal dengan maksimal k kali naik",
        "Jalan kaki mengikuti graf pejalan kaki OSM di walk.bin, lengkap dengan petunjuk belok",
        "Tarif dari GTFS ditambah aturan TransJakarta: Rp2.000 pukul 05.00–07.00, transfer 3 jam",
        "Opsi diurutkan untuk Tercepat, Termurah, dan Termudah"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cari tempat",
      "items": [
        "Halte langsung dari timetable, paham singkatan dan alias",
        "Indeks sekitar 157 ribu tempat OSM dengan kelurahan, kecamatan, dan kota",
        "Kurang dari 3 hasil: app bertanya ke Photon, hasilnya menyusul",
        "Jawaban /places, /stops, dan /geocode di-cache CDN Vercel sehari"
      ]
    },
    {
      "dot": "rose",
      "title": "Privasi dan keamanan",
      "items": [
        "Tanpa akun; riwayat tempat hanya di perangkat",
        "Koordinat di URL dibulatkan sekitar 11 m",
        "CSP ketat dari vercel.json, hash splash dicek saat build",
        "Rate limit /api/ di Vercel Firewall"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hosting dan offline",
      "items": [
        "Vercel men-deploy main; function berjalan di Singapura (sin1)",
        "Service worker menyimpan app, style, dan tile peta untuk dibuka lagi tanpa internet"
      ]
    }
  ]
