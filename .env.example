# Backend (dibaca lewat Makefile)
GORUTE_ADDR=:8080
GORUTE_OTP_URL=http://localhost:8081
GORUTE_OTP_DIR=../otp
GORUTE_PHOTON_URL=https://photon.komoot.io

# Docker Compose
# Heap Java untuk OTP. Harus di bawah batas RAM Docker Desktop (Settings > Resources).
OTP_MEMORY=3g
POSTGRES_USER=gorute
POSTGRES_PASSWORD=gorute
POSTGRES_DB=gorute
